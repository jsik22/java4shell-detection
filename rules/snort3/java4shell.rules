# java4shell-detection v0.10.0 (Snort 3)
# CVE-2026-114938 (Java4Shell): HTTP 요청 값 끝의 비정상 Base64 패딩 꼬리를 찾는다.
# 트리거 모양: Base64 문자 32자 이상 뒤 '='로 끝나며, 전체 길이를 4로 나눈 나머지가 1~3(정상 패딩은 0).
# 자체 제작·자체 시험이며 계속 업데이트 중이다. 제3자 검증 전이니 차단 대신 탐지(alert) 모드로 먼저 돌린다. HUNT 룰은 사냥용이다.
# 공격 시도만 알려 주고 성공 여부는 알려 주지 않는다. sid는 지역 룰 범위의 임의 값이다.
# https://github.com/jsik22/java4shell-detection

# 9114938 Authorization: Basic 값. 공개 PoC가 가장 많이 쓰는 경로(인증 전에 디코딩된다).
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 malformed Base64 tail in Authorization Basic"; flow:to_server,established; http_header:field authorization; content:"Basic",fast_pattern,nocase; pcre:"/Basic\s+(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?![A-Za-z0-9+\/_=-])/i"; classtype:attempted-admin; sid:9114938; rev:2; )

# 9114939 Authorization: Bearer 값. JWT처럼 점으로 나뉜 토큰은 조각 안의 트리거도 본다.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 malformed Base64 tail in Authorization Bearer"; flow:to_server,established; http_header:field authorization; content:"Bearer",fast_pattern,nocase; pcre:"/Bearer\s+(?:[^\s.]*\.)*(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?![A-Za-z0-9+\/_=-])/i"; classtype:attempted-admin; sid:9114939; rev:2; )

# 9114940 URL 쿼리 값. %2B·%2F·%3D 인코딩을 한 글자로 센다.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 malformed Base64 tail in URL query"; flow:to_server,established; http_raw_uri; content:"=",fast_pattern; pcre:"/[?&][^=&#]*=(?:[^&=#]{0,256}=)?(?:(?:[A-Za-z0-9+\/_-]|%2[BbFf]){4}){8,}(?:(?:=|%3[Dd]){1,3}|(?:[A-Za-z0-9+\/_-]|%2[BbFf])(?:=|%3[Dd]){1,2}|(?:[A-Za-z0-9+\/_-]|%2[BbFf]){2}(?:=|%3[Dd]))(?=[&#]|$)/"; classtype:attempted-admin; sid:9114940; rev:2; )

# 9114941 HUNT 요청 본문(폼·JSON·텍스트)의 값. 정상 본문에서도 울릴 수 있어 사냥용이다.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 HUNT malformed Base64 tail in request body"; flow:to_server,established; http_client_body; content:"=",fast_pattern; pcre:"/(?:^|[=:\x22\s,\[?])(?:(?:[A-Za-z0-9+\/_-]|%2[BbFf]){4}){8,}(?:(?:=|%3[Dd]){1,3}|(?:[A-Za-z0-9+\/_-]|%2[BbFf])(?:=|%3[Dd]){1,2}|(?:[A-Za-z0-9+\/_-]|%2[BbFf]){2}(?:=|%3[Dd]))(?=[\x22&\s,}\]?]|$)/"; classtype:attempted-admin; sid:9114941; rev:3; )

# 9114942 HUNT Authorization과 표준 헤더를 뺀 나머지 요청 헤더(X-Api-Key 등)의 값 자리.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 HUNT malformed Base64 tail in other request header"; flow:to_server,established; http_header; content:"=",fast_pattern; pcre:"/^(?!(?:Authorization|Host|User-Agent|Accept[A-Za-z-]*|Content-Type|Content-Length|Connection|Referer|Origin|Date|Cache-Control|Pragma|Upgrade|Upgrade-Insecure-Requests|Sec-Fetch-[A-Za-z]+|Sec-Ch-[A-Za-z-]+|DNT|TE|Priority)\s*:)[^:\r\n]+:[^\r\n]*?(?:(?<=:)\s*|(?<==)|(?<=[A-Za-z0-9] ))(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?![A-Za-z0-9+\/_=-])/mi"; classtype:attempted-admin; sid:9114942; rev:2; )

# 9114943 HUNT Cookie 값('이름=값'에서 값 자리만 본다).
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 HUNT malformed Base64 tail in Cookie"; flow:to_server,established; http_cookie; content:"=",fast_pattern; pcre:"/(?:^|\;)\s*[^=\;\s]+=(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?=[\;\s]|$)/"; classtype:attempted-admin; sid:9114943; rev:2; )

# 9114944 HUNT Basic 값 안쪽(이중 인코딩): Base64를 풀어 '사용자:비밀번호'의 비밀번호가 트리거 모양인지 본다. 앱이 비밀번호를 다시 디코딩할 때만 위험하다.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 HUNT malformed Base64 tail inside Basic password (double-encoded)"; flow:to_server,established; http_header:field authorization; content:"Basic ",fast_pattern,nocase; base64_decode:relative; base64_data; pcre:"/^[^:]*:(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?![A-Za-z0-9+\/_=-])/"; classtype:attempted-admin; sid:9114944; rev:1; )

# 9114945 Priority 헤더(RFC 9218 구조화 필드) 안 바이너리 항목(:값:)의 비정상 꼬리. 정상 Priority(u=, i)에는 바이너리 항목이 없다. Talos 11-19 공식 룰(1:301754)이 이 경로를 다룬 것을 보고 더함.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 malformed Base64 binary item in Priority header"; flow:to_server,established; http_header; content:"Priority:",fast_pattern,nocase; pcre:"/^Priority:[^\r\n]*:(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?![A-Za-z0-9+\/_=-])/mi"; classtype:attempted-admin; sid:9114945; rev:1; )

# 9114946 Authorization 헤더의 Basic·Bearer가 아닌 스킴(ApiKey 등) 값. Talos 67507·67508이 다루는 위치.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 malformed Base64 tail in Authorization other scheme"; flow:to_server,established; http_header:field authorization; content:"=",fast_pattern; pcre:"/^\s*(?!(?:basic|bearer)\s)[A-Za-z][A-Za-z0-9._~+\/-]*\s+(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?![A-Za-z0-9+\/_=-])/i"; classtype:attempted-admin; sid:9114946; rev:1; )

# 9114947 HUNT URL 경로 조각. '?' 앞 경로에서 '/' 뒤 값이 트리거 모양이고 '/', ':', ';', '?' 또는 끝으로 이어질 때. Talos 67504가 다루는 위치.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 HUNT malformed Base64 tail in URL path segment"; flow:to_server,established; http_raw_uri; content:"=",fast_pattern; pcre:"/^[^?#]*\/(?:(?:[A-Za-z0-9+_-]|%2[Bb]){4}){8,}(?:(?:=|%3[Dd]){1,3}|(?:[A-Za-z0-9+_-]|%2[Bb])(?:=|%3[Dd]){1,2}|(?:[A-Za-z0-9+_-]|%2[Bb]){2}(?:=|%3[Dd]))(?=[\/?\;:#]|$)/"; classtype:attempted-admin; sid:9114947; rev:1; )

# 9114948 요청 헤더 안 RFC 2047 인코딩 단어(=?charset?B?값?=, multipart boundary 등)의 값. Talos 67509가 다루는 위치.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 malformed Base64 tail in RFC 2047 encoded word in header"; flow:to_server,established; http_header; content:"?B?",fast_pattern,nocase; pcre:"/=\?[^?\s]{1,40}\?B\?(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?=\?=)/i"; classtype:attempted-admin; sid:9114948; rev:1; )

# 9114949 서버 안 스크립트(Elasticsearch Painless 등)가 트리거를 직접 만드는 요청. 요청 값에는 트리거가 없어 다른 룰이 못 본다.
# 본문에 Base64.getDecoder()·decode와 함께 '=' byte((byte) 61·0x3D·'=') 또는 트리거 모양 문자열 리터럴이 있을 때. 공개 PoC(_execute)·Talos 67513(_search) 모양.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 script builds Base64 trigger server-side (Painless)"; flow:to_server,established; http_client_body; content:"getDecoder",fast_pattern; content:"decode"; pcre:"/\(\s*byte\s*\)\s*(?:61\b|0x3[Dd]\b|'=')|(?:\x5c\x22|')(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?:\x5c\x22|')/"; classtype:attempted-admin; sid:9114949; rev:1; )

# 9114950 HUNT Elasticsearch API(경로에 '/_')로 보낸 스크립트에 Painless 허용 목록 밖 Java 이름(MethodHandles·defineClass·Class.forName·ClassLoader).
# 정상 Painless는 이 이름을 쓸 수 없어 컴파일되지 않는다. 공개 PoC가 트리거 뒤 체인에서 쓴다. 트리거를 숨긴 변형을 사냥할 때.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 HUNT Elasticsearch script uses non-allowlisted Java reflection"; flow:to_server,established; http_uri; content:"/_"; http_client_body; content:"script",fast_pattern; pcre:"/\b(?:MethodHandles|defineClass|Class\s*\.\s*forName|ClassLoader)\b/"; classtype:attempted-admin; sid:9114950; rev:1; )
